# Backend
TRACE_MODE=DEMO          # DEMO | LIVE
JWT_SECRET=change-me-in-production

# Frontend (used by Vite during dev)
VITE_API_URL=http://localhost:8000/api/v1

# Live mode — real on-chain lookups instead of the bundled demo dataset.
# ETH:  requires a free key from https://etherscan.io/myapikey
# TRX:  TronGrid works unauthenticated at low volume; add a free key from
#       https://www.trongrid.io/ to raise the rate limit
# BTC:  uses the public Blockstream Esplora API — no key needed
ETHERSCAN_API_KEY=
TRONGRID_API_KEY=

# Optional — enables a genuinely AI-generated narrative section (via the
# Anthropic API) instead of the deterministic rule-based one. Leave blank
# to keep using the rule-based narrative; nothing else changes.
ANTHROPIC_API_KEY=
